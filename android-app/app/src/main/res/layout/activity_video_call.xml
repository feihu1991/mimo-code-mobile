<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/call_background">
    <ImageView android:id="@+id/remoteVideoView" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone" />
    <FrameLayout android:id="@+id/remoteVideoContainer" android:layout_width="match_parent" android:layout_height="match_parent">
        <TextView android:id="@+id/characterAvatarText" android:layout_width="120dp" android:layout_height="120dp" android:layout_gravity="center" android:gravity="center" android:textSize="64sp" />
    </FrameLayout>
    <androidx.camera.view.PreviewView android:id="@+id/localPreview" android:layout_width="120dp" android:layout_height="160dp" android:layout_gravity="top|end" android:layout_margin="16dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/characterNameText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="20sp" android:textColor="@android:color/white" android:textStyle="bold" />
        <TextView android:id="@+id/statusText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="视频通话中..." android:textColor="@android:color/white" android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="horizontal" android:gravity="center" android:padding="32dp">
        <ImageButton android:id="@+id/muteButton" android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_mic" android:background="@drawable/bg_call_button" android:contentDescription="静音" android:scaleType="centerInside" />
        <ImageButton android:id="@+id/endCallButton" android:layout_width="64dp" android:layout_height="64dp" android:layout_marginHorizontal="32dp" android:src="@drawable/ic_call_end" android:background="@drawable/bg_end_call_button" android:contentDescription="挂断" android:scaleType="centerInside" />
        <ImageButton android:id="@+id/switchCameraButton" android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_camera_switch" android:background="@drawable/bg_call_button" android:contentDescription="切换摄像头" android:scaleType="centerInside" />
    </LinearLayout>
</FrameLayout>
